# ── 카카오 (https://developers.kakao.com) ──────────────────────
# JavaScript 키: 지도 SDK + 카카오톡 공유 (플랫폼 > Web 에 도메인 등록 필수)
NEXT_PUBLIC_KAKAO_JS_KEY=
# REST API 키: 카카오모빌리티 자동차 길찾기 (서버 전용)
KAKAO_REST_KEY=

# ── ODsay 대중교통 (https://lab.odsay.com) ── 서버 전용 (서버 IP 등록)
ODSAY_API_KEY=
# (배포용) ODsay Web(URI) 키를 쓸 때 등록한 사이트 주소. 비우면 NEXT_PUBLIC_SITE_URL 사용
ODSAY_REFERER=

# ── OpenWeatherMap (https://openweathermap.org/api) ── 서버 전용
OPENWEATHER_API_KEY=

# ── Firebase (프로젝트 설정 > 웹 앱) ─────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 공유 링크에 쓰일 사이트 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000
