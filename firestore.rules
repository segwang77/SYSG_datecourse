rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(uid())); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // 카운터 필드를 ±1 만 바꾸는 요청
    function counterStep(field) {
      return changed().hasOnly([field])
        && (request.resource.data[field] == resource.data[field] + 1
            || request.resource.data[field] == resource.data[field] - 1);
    }

    match /courses/{courseId} {
      function isMember() { return signedIn() && uid() in resource.data.members; }

      // 링크 공개는 id 를 아는 사람만 (목록 조회 불가), 전체 공개는 목록 조회 가능
      allow get: if resource.data.visibility in ['link', 'public'] || isMember();
      allow list: if resource.data.visibility == 'public' || isMember();

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.likeCount == 0
        && request.resource.data.scrapCount == 0
        && request.resource.data.reviewCount == 0;

      allow update: if
        // 1) 편집자: 소유자·초대코드·카운터·편집자 목록은 못 바꿈
        (isMember() && !changed().hasAny(['ownerId', 'inviteCode', 'members', 'likeCount', 'scrapCount', 'reviewCount', 'createdAt']))
        // 2) 초대 링크로 합류: 올바른 코드 + 자기 자신만 추가
        || (signedIn()
            && changed().hasOnly(['members', 'joinCode'])
            && request.resource.data.joinCode == resource.data.inviteCode
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && uid() in request.resource.data.members)
        // 3) 좋아요·스크랩·후기 카운터
        || (signedIn() && resource.data.visibility != 'private'
            && (counterStep('likeCount') || counterStep('scrapCount') || counterStep('reviewCount')));

      allow delete: if signedIn() && resource.data.ownerId == uid();

      match /likes/{userId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      match /candidates/{candId} {
        allow read, write: if signedIn()
          && uid() in get(/databases/$(database)/documents/courses/$(courseId)).data.members;
      }

      match /reviews/{reviewId} {
        function course() { return get(/databases/$(database)/documents/courses/$(courseId)).data; }
        allow read: if course().visibility != 'private' || (signedIn() && uid() in course().members);
        allow create: if signedIn() && request.resource.data.uid == uid() && course().visibility != 'private'
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.text.size() <= 200;
        allow delete: if signedIn() && resource.data.uid == uid();
      }
    }

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
      match /scraps/{courseId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /spots/{spotId} {
      allow read: if resource.data.status == 'approved' || isAdmin()
        || (signedIn() && resource.data.submittedBy == uid());
      allow create: if signedIn() && request.resource.data.submittedBy == uid() && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 관리자 목록은 Firebase 콘솔에서만 추가
    match /admins/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow write: if false;
    }
  }
}
